<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.myj.shopping.dao.ProductTypeDao">

	<resultMap id="ProductType" type="com.myj.shopping.model.ProductType" >
		<result column="product_type_name" property="productTypeName"/>
		<result column="create_time" property="createTime"/>
		<result column="update_time" property="updateTime"/>
		<result column="del_flag" property="delFlag"/>
	</resultMap>

	<!-- 通用查询结果列-->
	<sql id="Base_Column_List">
		id,
		product_type_name,
		create_time,
		update_time,
		del_flag
	</sql>

	<!-- 查询（根据主键ID查询） -->
	<select id="selectByPrimaryKey" resultMap="ProductType" parameterType="java.lang.Integer">
		 SELECT
		 <include refid="Base_Column_List" />
		 FROM product_type
		 WHERE id = #{id}
	</select>

	<!--删除：根据主键ID删除-->
	<delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
		 DELETE FROM product_type
		 WHERE id = #{id}
	</delete>

	<!-- 添加 -->
	<insert id="insert" parameterType="com.myj.shopping.model.ProductType" >
		 INSERT INTO product_type
 		(
			 id,
			 product_type_name,
			 create_time,
			 update_time,
			 del_flag
		) 
		 VALUES 
 		(
			 #{id},
			 #{productTypeName},
			 sysdate(),
 		     sysdate(),
 		     0
 		) 

	</insert>

	<!-- 修 改-->
	<update id="updateByPrimaryKeySelective" parameterType="com.myj.shopping.model.ProductType" >
		 UPDATE product_type
 		 <set> 
			<if test="productTypeName != null and productTypeName != ''">
				 product_type_name = #{productTypeName},
			</if>
			<if test="createTime != null">
				 create_time = #{createTime},
			</if>
			<if test="updateTime != null">
				 update_time = sysdate(),
			</if>
			<if test="delFlag != null">
				 del_flag = #{delFlag},
			</if>

 		 </set>
		 WHERE id = #{id}
	</update>

	<!-- list4Page 分页查询-->
	<select id="list4Page" resultMap="ProductType">
		 SELECT 
		 <include refid="Base_Column_List" />
		 from product_type
 		 where 1=1  
		<if test="record.id != null">
			 and id = #{record.id}
		</if>
		<if test="record.productTypeName != null and record.productTypeName != ''">
			and product_type_name like concat('%',#{record.productTypeName},'%')
		</if>
		and del_flag = 0
		<if test="commonQueryParam != null">

			<if test="commonQueryParam.start != null  and commonQueryParam.pageSize != null">
				 limit #{commonQueryParam.start}, #{commonQueryParam.pageSize}
			</if>
		</if>
	</select>
	<!-- count 总数-->
	<select id="count" resultType="int">
		 SELECT 
		 count(1) 
		 from product_type
 		 where 1=1
		<if test="id != null">
			and id = #{record.id}
		</if>
		<if test="productTypeName != null and productTypeName != ''">
			and product_type_name like concat('%',#{productTypeName},'%')
		</if>
		and del_flag = 0
	</select>
	<!-- list 查询-->
	<select id="list" resultMap="ProductType">
		 SELECT 
		 <include refid="Base_Column_List" />
		 from product_type
 		 where 1=1  
		<if test="id != null">
			 and id = #{id} 
		</if>
		<if test="productTypeName != null and productTypeName != ''">
			 and product_type_name = #{productTypeName} 
		</if>
		<if test="createTime != null">
			 and create_time = #{createTime} 
		</if>
		<if test="updateTime != null">
			 and update_time = #{updateTime} 
		</if>
		<if test="delFlag != null">
			 and del_flag = #{delFlag} 
		</if>
	</select>
</mapper>